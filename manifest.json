{
    "manifest_version": 3,
    "name": "MagnetSniffer",
    "version": "0.1.0",
    "description": "自动识别页面中的磁力链接并转为可点击链接",
    "browser_specific_settings": {
        "gecko": {
            "id": "i314q159@outlook.com",
            "data_collection_permissions": {
                "required": [
                    "none"
                ],
                "optional": []
            }
        },
        "strict_min_version": "140.0"
    },
    "icons": {
        "48": "icons/icon-48.svg"
    },
    "action": {
        "default_icon": {
            "48": "icons/icon-48.svg"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content/content.js"
            ]
        }
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "permissions": []
}
